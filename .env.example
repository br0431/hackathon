# Copia este archivo a .env.local y rellénalo. .env.local nunca se sube al repositorio.
# Se valida al arrancar (lib/env/schema.ts): si falta algo, `pnpm dev` se detiene y dice qué.

# --- Públicas (llegan al navegador) -------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública: "anon" (JWT) o "publishable" (sb_publishable_…). Nunca la secreta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la app (en Vercel, la del despliegue)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor (nunca con prefijo NEXT_PUBLIC_) -----------------------------
# Clave service_role o secret (sb_secret_…). Opcional en el hito 0, obligatoria desde el hito 2.
SUPABASE_SERVICE_ROLE_KEY=

# Pagos: en la v1 solo "mock" (simulado).
BILLING_PROVIDER=mock

# Fase 2 (Stripe en modo test). Déjalas vacías en la v1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_REMATE=
STRIPE_PRICE_ID_ACE=
